# Copia este archivo como .env y completa tus credenciales reales de Supabase.
DEBUG=True
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DEMO_MODE=False

# Recomendado para la aplicación: Transaction pooler (puerto 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:TU_PASSWORD@HOST-POOLER:6543/postgres
# 0 evita agotar el pool: Django cierra la conexión al finalizar cada request.
DATABASE_CONN_MAX_AGE=0
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PATIENT_BUCKET=patient-photos
SUPABASE_PAYMENT_BUCKET=payment-proofs
QRMED_COMPANY_NAME=QRMed Emergency
QRMED_COMPANY_TAX_ID=
QRMED_COMPANY_ADDRESS=Loja, Ecuador
QRMED_COMPANY_PHONE=
QRMED_COMPANY_EMAIL=qrmedicsupport@gmail.com
SUPABASE_PROFILE_BUCKET=profile-images
SUPABASE_BANK_BUCKET=bank-assets
